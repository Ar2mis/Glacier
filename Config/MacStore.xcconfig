#include "Shared.xcconfig"
PRODUCT_NAME = Glacier
PRODUCT_BUNDLE_IDENTIFIER = $(GLACIER_MAC_BUNDLE_ID)
INFOPLIST_FILE = Config/Mac-Info.plist
SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
MACOSX_DEPLOYMENT_TARGET = 26.0
ARCHS = arm64
ENABLE_APP_SANDBOX = YES
ENABLE_HARDENED_RUNTIME = YES
CODE_SIGN_ENTITLEMENTS = Config/GlacierMac.entitlements
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) APP_STORE
GLACIER_DISTRIBUTION = store
